# Variables de entorno para conectar con la WhatsApp Cloud API (Meta).
# Cópialo como .env y complétalo SOLO cuando vayas a escalar a producción.
# El demo local (demo.py) no necesita ninguna de estas variables.

# Token que TÚ inventas; debe coincidir con el que registras en Meta al
# configurar el webhook (paso de verificación).
WHATSAPP_VERIFY_TOKEN=mi_token_secreto

# ID del número de teléfono de WhatsApp Business (lo da Meta en el panel).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Token de acceso de la Graph API (temporal de prueba o permanente de sistema).
WHATSAPP_ACCESS_TOKEN=EAAG...

# (Opcional) Versión de la Graph API a usar.
WHATSAPP_API_VERSION=v21.0

# (Opcional) Puerto del servidor webhook.
PORT=5000
